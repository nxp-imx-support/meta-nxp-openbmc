From 39badb7663b322db2d953ba6e92f018d5d6b7d0b Mon Sep 17 00:00:00 2001
From: Mayank Mahajan <mayankmahajan.x@nxp.com>
Date: Thu, 5 Feb 2026 12:48:24 +0530
Subject: [PATCH 02/11] P3T2030 temperature sensor support for IMX.93

Add child node in lpi2c1 for P3T2030 target device.

Upstream-Status: Pending

Signed-off-by: Mayank Mahajan <mayankmahajan.x@nxp.com>
---
 arch/arm64/boot/dts/freescale/imx93-11x11-frdm-bmc.dts | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/arch/arm64/boot/dts/freescale/imx93-11x11-frdm-bmc.dts b/arch/arm64/boot/dts/freescale/imx93-11x11-frdm-bmc.dts
index b4145a282..170a88216 100644
--- a/arch/arm64/boot/dts/freescale/imx93-11x11-frdm-bmc.dts
+++ b/arch/arm64/boot/dts/freescale/imx93-11x11-frdm-bmc.dts
@@ -120,3 +120,9 @@ sensor@48 {
 
 };
 
+&lpi2c1 {
+	p3t2030@72 {
+		compatible = "ti,tmp108";
+		reg = <0x72>;
+	};
+};
-- 
