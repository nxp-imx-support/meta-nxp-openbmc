From 93864ec6126c1db07ed7b304a3fb957022957ff4 Mon Sep 17 00:00:00 2001
From: Nikhil Gupta <nikhil.gupta_2@nxp.com>
Date: Fri, 31 Jul 2026 20:33:23 +0530
Subject: [PATCH 2/4] PCI: endpoint: core: restore generic BAR alloc, remove
 VGA-specific hacks

Remove hard-coded BAR_2/BAR_4 display-specific branches and
DPU95_ADDRESS_SPACE macro from pci_epf_alloc_space(). Restore
original dma_alloc_coherent() path. Add ops->alloc_bar/free_bar hooks.

Upstream-Status: Pending
Signed-off-by: Nikhil Gupta <nikhil.gupta_2@nxp.com>
---
 drivers/pci/endpoint/pci-epf-core.c | 64 ++++++++---------------------
 1 file changed, 18 insertions(+), 46 deletions(-)

diff --git a/drivers/pci/endpoint/pci-epf-core.c b/drivers/pci/endpoint/pci-epf-core.c
index e78d9db48415..11edb53a5bc7 100644
--- a/drivers/pci/endpoint/pci-epf-core.c
+++ b/drivers/pci/endpoint/pci-epf-core.c
@@ -10,15 +10,11 @@
 #include <linux/dma-mapping.h>
 #include <linux/slab.h>
 #include <linux/module.h>
-#include <linux/of.h>
-#include <linux/of_address.h>
-#include <linux/ioport.h>
 
 #include <linux/pci-epc.h>
 #include <linux/pci-epf.h>
 #include <linux/pci-ep-cfs.h>
 
-#define DPU95_ADDRESS_SPACE 0x4b400000
 static DEFINE_MUTEX(pci_epf_mutex);
 
 static const struct bus_type pci_epf_bus_type;
@@ -239,10 +235,19 @@ void pci_epf_free_space(struct pci_epf *epf, void *addr, enum pci_barno bar,
 		epf_bar = epf->sec_epc_bar;
 	}
 
+	/* If the driver supplied its own allocator, let it free too.
+	 * free_bar returns true if it handled the free (skip dma_free_coherent),
+	 * false if the core should call dma_free_coherent(epc->dev.parent).
+	 */
+	if (epf->driver && epf->driver->ops && epf->driver->ops->free_bar &&
+	    epf->driver->ops->free_bar(epf, bar, addr, epf_bar[bar].size))
+		goto clear;
+
 	dev = epc->dev.parent;
 	dma_free_coherent(dev, epf_bar[bar].aligned_size, addr,
 			  epf_bar[bar].phys_addr);
 
+clear:
 	epf_bar[bar].phys_addr = 0;
 	epf_bar[bar].addr = NULL;
 	epf_bar[bar].size = 0;
@@ -313,39 +318,16 @@ void *pci_epf_alloc_space(struct pci_epf *epf, size_t size, enum pci_barno bar,
 
 	dev = epc->dev.parent;
 
-	if (bar == BAR_4) {
-		void __iomem *vaddr = ioremap(DPU95_ADDRESS_SPACE, size);
-		space = (__force void *)vaddr;
-
-	} else if (bar == BAR_2) {
-		struct device_node *vram_node;
-		struct resource res;
-
-		vram_node = of_find_node_by_name(NULL, "vram");
-		if (!vram_node) {
-			pr_err("VRAM node not found\n");
-			return NULL;
-		}
-
-		of_address_to_resource(vram_node, 0, &res);
-		phys_addr = res.start;
-
-		size = resource_size(&res);
-
-		void __iomem *vaddr_fb = ioremap_wc(phys_addr, size);
-
-		if (!vaddr_fb) {
-			dev_err(&epf->dev, "Failed to remap framebuffer\n");
-			return NULL;
-		}
-
-		space = (__force void *)vaddr_fb;
-
-	} else {
-
-		space = dma_alloc_coherent(dev, aligned_size, &phys_addr, GFP_KERNEL);
+	/* Give the EPF driver a chance to supply its own BAR allocator.
+	 * A NULL return means "I don't handle this BAR" — fall back to
+	 * dma_alloc_coherent(epc->dev.parent).
+	 */
+	if (epf->driver && epf->driver->ops && epf->driver->ops->alloc_bar)
+		space = epf->driver->ops->alloc_bar(epf, bar, aligned_size, &phys_addr);
 
-	}
+	if (!space)
+		space = dma_alloc_coherent(dev, aligned_size, &phys_addr,
+					   GFP_KERNEL);
 
 	if (!space) {
 		dev_err(dev, "failed to allocate mem space\n");
@@ -356,16 +338,6 @@ void *pci_epf_alloc_space(struct pci_epf *epf, size_t size, enum pci_barno bar,
 	epf_bar[bar].addr = space;
 	epf_bar[bar].size = size;
 	epf_bar[bar].aligned_size = aligned_size;
-	if (bar == BAR_4) {
-		epf_bar[bar].phys_addr = DPU95_ADDRESS_SPACE;
-		epf_bar[bar].size = size;
-	}
-	else if (bar == BAR_2) {
-		pr_info("BAR 2 VRAM phys address = 0x%pa\n", &phys_addr);
-		pr_info("BAR 2 VRAM size = 0x%zx\n", size);
-		memset(epf_bar[bar].addr, 0x00, epf_bar[bar].size);
-		epf_bar[bar].flags |= PCI_BASE_ADDRESS_MEM_PREFETCH | PCI_BASE_ADDRESS_SPACE_MEMORY;
-	}
 	epf_bar[bar].barno = bar;
 	if (upper_32_bits(size) || epc_features->bar[bar].only_64bit)
 		epf_bar[bar].flags |= PCI_BASE_ADDRESS_MEM_TYPE_64;
-- 
