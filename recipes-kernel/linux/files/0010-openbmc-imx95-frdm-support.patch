From f9e6d1a2fe54085b13bd35fa93d334f8f48addfe Mon Sep 17 00:00:00 2001
From: Disha Das <disha.das@nxp.com>
Date: Thu, 25 Jun 2026 16:43:01 +0530
Subject: [PATCH 06/11] openbmc: add support for imx95 frdm

Upstream-Status: Inappropriate [oe specific]
Signed-off-by: Disha Das <disha.das@nxp.com>
---
 arch/arm64/boot/dts/freescale/Makefile            |  2 +-
 .../boot/dts/freescale/imx95-15x15-frdm-bmc.dts   | 15 +++++++++++++++
 2 files changed, 16 insertions(+), 1 deletion(-)
 create mode 100644 arch/arm64/boot/dts/freescale/imx95-15x15-frdm-bmc.dts

diff --git a/arch/arm64/boot/dts/freescale/Makefile b/arch/arm64/boot/dts/freescale/Makefile
index 1bab6b1a5..1753436e2 100644
--- a/arch/arm64/boot/dts/freescale/Makefile
+++ b/arch/arm64/boot/dts/freescale/Makefile
@@ -1182,7 +1182,7 @@ dtb-$(CONFIG_ARCH_MXC) += imx95-19x19-verdin-rm692c9.dtb
 imx95-19x19-verdin-root-dtbs := imx95-19x19-verdin.dtb imx95-19x19-verdin-root.dtbo
 dtb-$(CONFIG_ARCH_MXC) += imx95-19x19-verdin-root.dtb imx95-19x19-verdin-inmate.dtb
 
-dtb-$(CONFIG_ARCH_MXC) += imx95-15x15-frdm.dtb imx95-15x15-frdm-boe-wxga-lvds-panel.dtb
+dtb-$(CONFIG_ARCH_MXC) += imx95-15x15-frdm.dtb imx95-15x15-frdm-bmc.dtb  imx95-15x15-frdm-boe-wxga-lvds-panel.dtb
 
 imx95-15x15-frdm-waveshare-7inch-c-panel-dtbs := imx95-15x15-frdm.dtb imx95-15x15-frdm-waveshare-7inch-c-panel.dtbo
 dtb-$(CONFIG_ARCH_MXC) += imx95-15x15-frdm-waveshare-7inch-c-panel.dtb
diff --git a/arch/arm64/boot/dts/freescale/imx95-15x15-frdm-bmc.dts b/arch/arm64/boot/dts/freescale/imx95-15x15-frdm-bmc.dts
new file mode 100644
index 000000000..050500731
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx95-15x15-frdm-bmc.dts
@@ -0,0 +1,15 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright 2026 NXP
+ */
+
+/dts-v1/;
+
+
+#include "imx95-15x15-frdm.dts"
+
+/ {
+    model = "i.MX95 FRDM BMC";
+
+    /* Add override changes for openbmc */
+};
