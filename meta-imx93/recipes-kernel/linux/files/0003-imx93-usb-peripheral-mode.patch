From: Neha Mamoria <neha.mamoria@nxp.com>
Subject: [PATCH] imx93: force USB controller to peripheral mode for OpenBMC

Upstream-Status: Inappropriate [OpenBMC specific]
Signed-off-by: Neha Mamoria <neha.mamoria@nxp.com>

---

diff --git a/arch/arm64/boot/dts/freescale/imx93-11x11-frdm-bmc.dts b/arch/arm64/boot/dts/freescale/imx93-11x11-frdm-bmc.dts
index 170a88216b93..6c7007ba050f 100644
--- a/arch/arm64/boot/dts/freescale/imx93-11x11-frdm-bmc.dts
+++ b/arch/arm64/boot/dts/freescale/imx93-11x11-frdm-bmc.dts
@@ -30,6 +30,13 @@ &lpuart8 { /* console */
 	status = "okay";
 };
 
+
+/* Force USB device (peripheral) mode for OpenBMC */
+&usbotg1 {
+        dr_mode = "peripheral";
+        status = "okay";
+};
+
 &iomuxc {
 
 pinctrl_lpi2c5: lpi2c5grp {
