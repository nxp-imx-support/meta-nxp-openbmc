diff --git a/meta-imx95/recipes-bsp/u-boot/files/0001-Update-the-flash-clock-30-MHz-with-1-1-1-protocol.patch b/meta-imx95/recipes-bsp/u-boot/files/0001-Update-the-flash-clock-30-MHz-with-1-1-1-protocol.patch
