@@ -13,6 +13,7 @@ FILESEXTRAPATHS:prepend := "${@'${THISDIR}/files/:' if d.getVar('LATU_USE_CUSTOM

 SRC_URI:append:latu-dcsm-imx95 = "${@' file://defconfig-fragment.cfg' if d.getVar('LATU_USE_CUSTOM_SRC') == '1' else ' file://fspi/defconfig-fragment.cfg'}"
 SRC_URI:append:latu-dcsm-imx95 = "${@' file://custom-bmc-env-nor.cmd' if d.getVar('LATU_USE_CUSTOM_SRC') == '1' else ' file://fspi/custom-bmc-env-nor.cmd'}"
+SRC_URI:append:latu-dcsm-imx95 = "${@'' if d.getVar('LATU_USE_CUSTOM_SRC') == '1' else ' file://0001-Update-the-flash-clock-30-MHz-with-1-1-1-protocol.patch'}"

