+  dataValidTime:
+    # ---------------------------------------===== dllAValidTime [Optional] =====---------------------------------------
+    # Description: Offset: 0b, Width: 16b,  Data valid time for DLLA in terms of 0.1 ns
+    dllAValidTime: 0
+    # ---------------------------------------===== dllBValidTime [Optional] =====---------------------------------------
+    # Description: Offset: 16b, Width: 16b,  Data valid time for DLLB in terms of 0.1 ns
+    dllBValidTime: 0
