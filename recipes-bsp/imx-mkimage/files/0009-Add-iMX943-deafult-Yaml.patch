+  sflashPadType: '0x00'
+  # ----------------------------------------===== serialClkFreq [Optional] =====----------------------------------------
+  # Description: Offset: 0x00000046, Width: 8b;  [0x046-0x046] Serial Flash Frequency, device specific definitions, See
