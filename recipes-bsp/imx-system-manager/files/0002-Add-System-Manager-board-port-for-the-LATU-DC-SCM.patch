-    if ((status & BIT8(PCAL6408A_INPUT_BUTTON)) != 0U)
-    {
-        LMM_MiscControlEvent(BRD_SM_CTRL_BUTTON,
-            ((data >> PCAL6408A_INPUT_BUTTON) & 0x1U) + 1U);
-    }
-}
