   lookupTable_seq0_instr2:
-    # instr2: 6 dummy clocks on 4 wires (SDR) - required at 100 MHz per MX66U1G45G datasheet
     OPERAND: '0x06'
     NUM_PADS: 4PAD
     OPERATION_CODE: DUMMY_SDR
   lookupTable_seq0_instr3:
-    # instr3: read data on 4 wires (SDR)
     OPERAND: '0x04'
     NUM_PADS: 4PAD
     OPERATION_CODE: READ_SDR
