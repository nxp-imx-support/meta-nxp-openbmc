From 976d0b0233040f1511b2eba853fd798f5aa9fbfc Mon Sep 17 00:00:00 2001
From: Disha Das <disha.das@nxp.com>
Date: Tue, 13 Oct 2026 10:58:18 +0000
Subject: [PATCH] Port the imx943-dc-scm dtsi for 2026.04

Upstream-Status: Pending

Signed-off-by: Nikhil Gupta <nikhil.gupta_2@nxp.com>
---
 arch/arm/dts/imx943-dc-scm-u-boot.dtsi | 386 +++++++++++++------------
 arch/arm/dts/imx943-dc-scm.dts         |  76 ++---
 2 files changed, 243 insertions(+), 219 deletions(-)

diff --git a/arch/arm/dts/imx943-dc-scm-u-boot.dtsi b/arch/arm/dts/imx943-dc-scm-u-boot.dtsi
index 14f92659..eab4d889 100644
--- a/arch/arm/dts/imx943-dc-scm-u-boot.dtsi
+++ b/arch/arm/dts/imx943-dc-scm-u-boot.dtsi
@@ -3,229 +3,253 @@
  * Copyright 2025 NXP
  */
 
-&aips1 {
-	bootph-all;
-	bootph-pre-ram;
-};
-
-&aips2 {
-	bootph-all;
-	bootph-pre-ram;
-};
-
-&aips3 {
-	bootph-all;
-	bootph-pre-ram;
-};
-
-&clk_ext1 {
-	bootph-all;
-	bootph-pre-ram;
-};
-
-&dispmix_csr {
-	/delete-property/ assigned-clocks;
-	/delete-property/ assigned-clock-rates;
-	/delete-property/ assigned-clock-parents;
-};
-
-&dummy {
-	bootph-all;
-	bootph-pre-ram;
-};
-
-&elemu1 {
-	compatible = "fsl,imx93-mu-s4";
-	bootph-all;
-	bootph-pre-ram;
-	status = "okay";
-};
-
-&elemu3 {
-	compatible = "fsl,imx93-mu-s4";
-	bootph-all;
-	bootph-pre-ram;
-	status = "okay";
-};
-
-&gpio2 {
-	reg = <0 0x43810000 0 0x1000>, <0 0x43810040 0 0x40>;
-	bootph-pre-ram;
-};
-
-&gpio3 {
-	reg = <0 0x43820000 0 0x1000>, <0 0x43820040 0 0x40>;
-	bootph-pre-ram;
-};
-
-&gpio4 {
-	reg = <0 0x43840000 0 0x1000>, <0 0x43840040 0 0x40>;
-	bootph-pre-ram;
-};
-
-&gpio5 {
-	reg = <0 0x43850000 0 0x1000>, <0 0x43850040 0 0x40>;
-	bootph-pre-ram;
-};
-
-&gpio6 {
-	reg = <0 0x43860000 0 0x1000>, <0 0x43860040 0 0x40>;
-	bootph-pre-ram;
-};
-
-&gpio7 {
-	reg = <0 0x43870000 0 0x1000>, <0 0x43870040 0 0x40>;
-	bootph-pre-ram;
+#include "imx943-u-boot.dtsi"
+
+/ {
+	aliases {
+		gpio1 = &gpio2;
+		gpio2 = &gpio3;
+		gpio3 = &gpio4;
+		gpio4 = &gpio5;
+		gpio5 = &gpio6;
+		gpio6 = &gpio7;
+		serial0 = &lpuart1;
+		ethernet0 = &enetc0;
+		usb0 = &usb3_dwc3;
+		usb1 = &usb2;
+		usb_gadget0 = &usb3_dwc3;
+		usb_gadget1 = &usbg2;
+	};
+
+	usbg2: usbg2 {
+		compatible = "fsl,imx27-usb-gadget";
+		dr_mode = "peripheral";
+		chipidea,usb = <&usb2>;
+		status = "okay";
+	};
+
+	chosen {
+		bootargs = "console=ttyLP0,115200 earlycon";
+	};
+
+	reg_gpy_en: regulator-gpy-en {
+		compatible = "regulator-fixed";
+		regulator-name = "gpy-en";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+    regulator-always-on;
+    regulator-boot-on;  
+	};
+
+	xtal25m: clock-xtal25m {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <25000000>;
+		clock-output-names = "xtal_25MHz";
+	};
+
+	cm70: imx943-cm70 {
+		compatible = "fsl,imx94-cm70";
+	};
+
+	cm71: imx943-cm71 {
+		compatible = "fsl,imx94-cm71";
+	};
+
+	cm33s: imx943-cm33s {
+		compatible = "fsl,imx94-cm33s";
+	};
+};
+
+&pcal6416_i2c6_u44 {
+	/* Switch-port2/ENET0 IOMUX selection */
+	switch-port2-sel-hog {
+		gpio-hog;
+		gpios = <2 GPIO_ACTIVE_HIGH>;
+		output-high;
+	};
+
+	/* ENET1 IOMUX selection */
+	enetc1-sel-hog {
+		gpio-hog;
+		gpios = <3 GPIO_ACTIVE_HIGH>;
+		output-high;
+	};
+
+	/* ENET2 IOMUX selection */
+	enetc2-sel-hog {
+		gpio-hog;
+		gpios = <4 GPIO_ACTIVE_HIGH>;
+		output-high;
+	};
 };
 
 &lpuart1 {
 	bootph-pre-ram;
 };
 
-&mu2 {
-	bootph-all;
-	bootph-pre-ram;
+&lpi2c6 {
+    bootph-pre-ram;
 };
 
-&osc_24m {
-	bootph-all;
-	bootph-pre-ram;
-};
+&pca9544_i2c6 { bootph-pre-ram; };
 
-&pinctrl_reg_usdhc2_vmmc {
-	bootph-pre-ram;
-};
-
-&pinctrl_uart1 {
