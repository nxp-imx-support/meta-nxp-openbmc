[Unit]
Description=DPU DRM Atomic Scaler
After=systemd-udev-settle.service dev-dri-card0.device
Requires=systemd-udev-settle.service
ConditionPathExists=/dev/dri/card0

[Service]
Type=oneshot
ExecStart=/usr/bin/dpu_pci_scan
KillSignal=SIGTERM
RemainAfterExit=no
Restart=no

[Install]
WantedBy=multi-user.target