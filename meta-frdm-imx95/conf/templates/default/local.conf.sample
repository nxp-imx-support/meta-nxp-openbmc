# NXP imx95 example local.conf settings
# This file is a convenience template and may be freely modified by the user

MACHINE ??= "frdm-imx95"
DISTRO ?= "openbmc-phosphor"
PACKAGE_CLASSES ?= "package_ipk"
SANITY_TESTED_DISTROS:append ?= " *"
EXTRA_IMAGE_FEATURES ?= "allow-root-login"
IMAGE_INSTALL:append = " net-tools curl lmsensors phosphor-hwmon openipmi ipmitool dbus-sensors socat entity-manager"
IMX_MIRROR ?= "https://www.nxp.com/lgfiles/NMG/MAD/YOCTO/"


# NXP Yocto mirror for source archives
MIRRORS += " \
${IMX_MIRROR}   http://download.ossystems.com.br/bsp/freescale/source/ \n \
"
FSL_MIRROR ?= "${IMX_MIRROR}"

ACCEPT_FSL_EULA = "1"
USER_CLASSES ?= "buildstats"
PATCHRESOLVE = "noop"
BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    STOPTASKS,/tmp,100M,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K \
    HALT,/tmp,10M,1K"
CONF_VERSION = "2"

# Limit parallel compilation to prevent the OOM killer from terminating
# cc1plus when building large C++ packages (phosphor-ipmi-host, dbus-sensors,
# entity-manager, phosphor-inventory-manager). Each cc1plus + LTO pass can
# consume 1-2 GB of RAM; without a cap ninja defaults to -j <nproc> which
# exhausts memory on build machines with many cores but limited RAM.
# Adjust BB_NUMBER_THREADS and PARALLEL_MAKE to match available RAM:
#   8 GB  -> use 4 / -j 4
#   16 GB -> use 8 / -j 8
#   32 GB -> use 16 / -j 16
BB_NUMBER_THREADS = "4"
PARALLEL_MAKE = "-j 4"
