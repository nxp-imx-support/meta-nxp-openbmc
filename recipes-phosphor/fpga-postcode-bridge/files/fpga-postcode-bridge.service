[Unit]
Description=FPGA SIM host POST code bridge into phosphor-post-code-manager
# phosphor-post-code-manager owns xyz.openbmc_project.State.Boot.Raw; the
# bridge writes the Value property on it, so it must be up first. The bridge
# also polls for the bus name itself, so a slow start here is not fatal.
Wants=xyz.openbmc_project.State.Boot.PostCode@0.service
After=xyz.openbmc_project.State.Boot.PostCode@0.service

[Service]
Type=simple
# Poll the PLDM sub-driver POST/boot-progress registers and republish each
# transition on State.Boot.Raw, which is what phosphor-post-code-manager
# records and Redfish exposes under LogServices/PostCodes.
ExecStart=/usr/bin/fpga_postcode_bridge.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
