[Unit]
Description=FPGA SIM host SEL / event-log bridge into phosphor-logging
Wants=xyz.openbmc_project.Logging.service
After=xyz.openbmc_project.Logging.service

[Service]
Type=simple
# Poll the PLDM sub-driver SEL snapshot and raise phosphor-logging entries so
# FPGA-simulated host events show up in the Redfish event log and the WebUI.
ExecStart=/usr/bin/fpga_sel_bridge.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
