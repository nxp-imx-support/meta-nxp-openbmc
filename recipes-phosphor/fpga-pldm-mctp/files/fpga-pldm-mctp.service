[Unit]
Description=FPGA SIM PLDM-over-MCTP responder (numeric temperature terminus)
Wants=network.target
After=network.target

[Service]
Type=simple
# Present the FPGA SIM as a PLDM terminus on MCTP. The sensor value is read
# live from the mailbox-backed hwmon device. Argument 1 is the hwmon input
# path; argument 2 is the terminus id (TID/EID).
ExecStart=/usr/bin/fpga_pldm_mctp /sys/class/hwmon/hwmon0/temp1_input 1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
